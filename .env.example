# .env.example — copy to .env and fill in. Never commit .env.
# The DB password is NOT here: it lives in secrets/db_password.txt (Docker secret).

# ---- Required ----
FLASK_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ---- Postgres (the db container is created with these; the app reuses them) ----
POSTGRES_USER=netadmin
POSTGRES_DB=network_inventory

# ---- Image version (docker compose pull): "latest" or a release like 1.0.0 ----
HOSTLORE_TAG=latest

# ---- Gunicorn ----
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info

# ---- Optional: HTTP basic auth (strongly recommended before exposing the app) ----
# Hash: python -c 'import bcrypt; print(bcrypt.hashpw(b"your-pass", bcrypt.gensalt()).decode())'
HOSTLORE_AUTH_USER=
HOSTLORE_AUTH_PASSWORD_HASH=

# ---- Optional: automatic scans ("15m", "1h"; empty = disabled) ----
SCAN_SCHEDULE_INTERVAL=

# ---- Optional: Grafana admin (observability overlay) ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME
