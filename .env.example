# .env.example  (commit this file)

# ---- Postgres container credentials (DB gets created with these) ----
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=network_inventory

# ---- App connection to Postgres (usually same as above) ----
DB_HOST=db
DB_PORT=5432
DB_USER=${POSTGRES_USER}
DB_NAME=${POSTGRES_DB}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ---- Flask secret key (must be changed) ----
FLASK_SECRET_KEY=CHANGE_ME_SECRET
